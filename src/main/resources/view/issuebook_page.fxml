<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="580.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.IssueBookPageController">
   <children>
      <Label layoutX="200.0" layoutY="30.0" text="Issue Book">
         <font>
            <Font name="Bell MT Bold" size="24.0" />
         </font>
      </Label>
      <Label layoutX="50.0" layoutY="110.0" text="Select Member" />
      <ComboBox fx:id="cmbMember" layoutX="50.0" layoutY="134.0" prefWidth="220.0" promptText="Choose a member" />
      <Label layoutX="300.0" layoutY="110.0" text="Select Book" />
      <ComboBox fx:id="cmbBook" layoutX="300.0" layoutY="134.0" prefWidth="220.0" promptText="Choose a book" />
      <Label layoutX="50.0" layoutY="195.0" text="Issue Date" />
      <DatePicker fx:id="dpIssueDate" layoutX="50.0" layoutY="219.0" prefWidth="220.0" />
      <Label layoutX="300.0" layoutY="195.0" text="Due Date" />
      <DatePicker fx:id="dpDueDate" layoutX="300.0" layoutY="219.0" prefWidth="220.0" />
      <Button fx:id="btnissuebook" layoutX="50.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnissuebookOnAction" text="Issue Book" />
      <Button fx:id="btnclear" layoutX="150.0" layoutY="300.0" mnemonicParsing="false" onAction="#btnclearOnAction" prefHeight="26.0" prefWidth="64.0" text="Clear" />
   </children>
</AnchorPane>