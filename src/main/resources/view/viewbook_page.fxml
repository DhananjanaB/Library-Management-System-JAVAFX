<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="720.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ViewBookPageController">
    <children>
        <Label layoutX="40.0" layoutY="15.0" text="View Books">
            <font>
                <Font name="Bell MT Bold" size="25.0" />
            </font>
        </Label>
        <TextField fx:id="txtSearch" layoutX="40.0" layoutY="60.0" prefWidth="300.0" promptText="Search by title, author or ID" />
        <TableView fx:id="table" layoutX="40.0" layoutY="100.0" prefHeight="230.0" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="id" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="title" prefWidth="170.0" text="Title" />
                <TableColumn fx:id="author" prefWidth="140.0" text="Author" />
                <TableColumn fx:id="category" prefWidth="110.0" text="Category" />
                <TableColumn fx:id="year" prefWidth="70.0" text="Year" />
                <TableColumn fx:id="qty" prefWidth="60.0" text="Qty" />
            </columns>
        </TableView>
        <Label layoutX="40.0" layoutY="340.0" text="Selected book (click a row to edit)" />
        <TextField fx:id="txtBookId" editable="false" layoutX="40.0" layoutY="365.0" prefWidth="90.0" promptText="ID" />
        <TextField fx:id="txtTitle" layoutX="145.0" layoutY="365.0" prefWidth="180.0" promptText="Title" />
        <TextField fx:id="txtAuthor" layoutX="340.0" layoutY="365.0" prefWidth="170.0" promptText="Author" />
        <TextField fx:id="txtCategory" layoutX="525.0" layoutY="365.0" prefWidth="155.0" promptText="Category" />
        <TextField fx:id="txtYear" layoutX="40.0" layoutY="405.0" prefWidth="90.0" promptText="Year" />
        <TextField fx:id="txtQuantity" layoutX="145.0" layoutY="405.0" prefWidth="90.0" promptText="Qty" />
        <Button layoutX="40.0" layoutY="450.0" mnemonicParsing="false" onAction="#btnupdateOnAction" text="Update" />
        <Button layoutX="120.0" layoutY="450.0" mnemonicParsing="false" onAction="#btndeleteOnAction" text="Delete" />
        <Button layoutX="200.0" layoutY="450.0" mnemonicParsing="false" onAction="#btnclearOnAction" text="Clear" />
    </children>
</AnchorPane>