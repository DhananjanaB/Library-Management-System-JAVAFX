<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="440.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ReturnBookPageController">
   <children>
      <Label layoutX="225.0" layoutY="30.0" text="Return Book">
         <font>
            <Font name="Bell MT Bold" size="23.0" />
         </font>
      </Label>
      <Label layoutX="60.0" layoutY="95.0" text="Borrowed book" />
      <ComboBox fx:id="cmbBorrowing" layoutX="60.0" layoutY="119.0" prefWidth="480.0" promptText="Select a borrowed book" />

      <Label layoutX="60.0" layoutY="175.0" text="Member" />
      <Label fx:id="lblMember" layoutX="60.0" layoutY="197.0" text="-" />
      <Label layoutX="320.0" layoutY="175.0" text="Book" />
      <Label fx:id="lblBook" layoutX="320.0" layoutY="197.0" text="-" />

      <Label layoutX="60.0" layoutY="235.0" text="Borrowed date" />
      <Label fx:id="lblBorrowDate" layoutX="60.0" layoutY="257.0" text="-" />
      <Label layoutX="320.0" layoutY="235.0" text="Due date" />
      <Label fx:id="lblDueDate" layoutX="320.0" layoutY="257.0" text="-" />

      <Label layoutX="60.0" layoutY="295.0" text="Return date" />
      <DatePicker fx:id="dpReturnDate" layoutX="60.0" layoutY="319.0" prefWidth="220.0" />
      <Label layoutX="320.0" layoutY="295.0" text="Status" />
      <Label fx:id="lblStatus" layoutX="320.0" layoutY="323.0" text="-" />

      <Button fx:id="btnreturnbook" layoutX="60.0" layoutY="380.0" mnemonicParsing="false" onAction="#btnreturnbookOnAction" text="Return Book" />
   </children>
</AnchorPane>