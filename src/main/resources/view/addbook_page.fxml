<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="441.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AddBookPageController">
   <children>
      <Label layoutX="238.0" layoutY="25.0" text="Add Book">
         <font>
            <Font name="Bell MT Bold" size="23.0" />
         </font>
      </Label>
      <Label layoutX="65.0" layoutY="100.0" text="Book ID / ISBN" />
      <TextField fx:id="txtBookId" layoutX="65.0" layoutY="124.0" />
      <Label layoutX="335.0" layoutY="100.0" text="Book Title" />
      <TextField fx:id="txtTitle" layoutX="335.0" layoutY="124.0" />
      <Label layoutX="65.0" layoutY="190.0" text="Author" />
      <TextField fx:id="txtAuthor" layoutX="65.0" layoutY="214.0" />
      <Label layoutX="335.0" layoutY="190.0" text="Category" />
      <TextField fx:id="txtCategory" layoutX="335.0" layoutY="214.0" />
      <Label layoutX="65.0" layoutY="280.0" text="Published year" />
      <TextField fx:id="txtYear" layoutX="65.0" layoutY="304.0" />
      <Label layoutX="335.0" layoutY="280.0" text="Quantity" />
      <TextField fx:id="txtQuantity" layoutX="335.0" layoutY="304.0" />
      <Button fx:id="btnaddbook" layoutX="109.0" layoutY="377.0" mnemonicParsing="false" onAction="#btnaddbookOnAction" text="Add Book" />
      <Button fx:id="btnclear" layoutX="238.0" layoutY="377.0" mnemonicParsing="false" onAction="#btnclearOnAction" prefHeight="26.0" prefWidth="62.0" text="Clear" />
   </children>
</AnchorPane>