<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="560.0" prefWidth="940.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.DashboardPageController">
   <left>
      <VBox prefWidth="200.0" spacing="4.0" styleClass="sidebar">
         <children>
            <Label styleClass="sidebar-title" text="Library System" />
            <Button fx:id="btnHome" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnHomeOnAction" styleClass="nav-button" text="Dashboard" />
            <Button fx:id="btnAddBook" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddBookOnAction" styleClass="nav-button" text="Add Book" />
            <Button fx:id="btnViewBooks" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnViewBooksOnAction" styleClass="nav-button" text="View Books" />
            <Button fx:id="btnAddMember" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnAddMemberOnAction" styleClass="nav-button" text="Add Member" />
            <Button fx:id="btnManageMembers" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnManageMembersOnAction" styleClass="nav-button" text="Manage Members" />
            <Button fx:id="btnIssueBook" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnIssueBookOnAction" styleClass="nav-button" text="Issue Book" />
            <Button fx:id="btnReturnBook" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnReturnBookOnAction" styleClass="nav-button" text="Return Book" />
            <Button fx:id="btnHistory" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnHistoryOnAction" styleClass="nav-button" text="Borrowing History" />
            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="btnLogout" maxWidth="Infinity" mnemonicParsing="false" onAction="#btnLogoutOnAction" styleClass="nav-button, logout-button" text="Logout" />
         </children>
      </VBox>
   </left>
   <center>
      <StackPane fx:id="contentArea" />
   </center>
</BorderPane>