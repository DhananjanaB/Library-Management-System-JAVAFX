<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="358.0" prefWidth="367.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.LoginPageController">
   <children>
      <Label layoutX="119.0" layoutY="32.0" text="Library System">
         <font>
            <Font name="Arial" size="19.0" />
         </font>
      </Label>
      <Label layoutX="133.0" layoutY="62.0" text="Librarian Login">
         <font>
            <Font size="14.0" />
         </font>
      </Label>

      <Label layoutX="53.0" layoutY="115.0" text="Username" />
      <TextField fx:id="txtUsername" layoutX="53.0" layoutY="135.0" prefWidth="260.0" promptText="Enter username" />

      <Label layoutX="53.0" layoutY="180.0" text="Password" />
      <PasswordField fx:id="txtPassword" layoutX="53.0" layoutY="200.0" prefWidth="260.0" promptText="Enter password" />

      <Label fx:id="lblError" layoutX="53.0" layoutY="237.0" textFill="red" />

      <Button fx:id="btnLogin" layoutX="53.0" layoutY="280.0" mnemonicParsing="false" onAction="#btnloginonAction" prefHeight="30.0" prefWidth="80.0" text="Login" />
      <Button fx:id="btnClear" layoutX="145.0" layoutY="280.0" mnemonicParsing="false" onAction="#btnclearonAction" prefHeight="30.0" prefWidth="80.0" text="Clear" />
   </children>
</AnchorPane>
